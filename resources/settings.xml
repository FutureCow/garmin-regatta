<settings>
    <setting propertyKey="ServerUrl" title="@Strings.ServerUrl">
        <settingConfig type="alphaNumeric">
            <textConfig hint="@Strings.ServerUrlHint"
                       defaultValue="https://regatta.fhettinga.nl"/>
        </settingConfig>
    </setting>
    <setting propertyKey="AuthToken" title="@Strings.AuthToken">
        <settingConfig type="alphaNumeric">
            <textConfig hint="@Strings.AuthTokenHint"/>
        </settingConfig>
    </setting>
    <setting propertyKey="RaceCode" title="@Strings.RaceCode">
        <settingConfig type="alphaNumeric">
            <textConfig hint="@Strings.RaceCodeHint"/>
        </settingConfig>
    </setting>
    <setting propertyKey="AutoSync" title="Auto-sync na opname">
        <settingConfig type="boolean">
            <booleanConfig defaultValue="true"/>
        </settingConfig>
    </setting>
</settings>
